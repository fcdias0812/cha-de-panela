{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": null,

  "installCommand": "npm --prefix backend install && npm --prefix frontend install",
  "buildCommand": "npm --prefix backend run generate && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",

  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "backend/node_modules/.prisma/client/**"
    }
  },

  "rewrites": [
    { "source": "/api/:caminho*", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
